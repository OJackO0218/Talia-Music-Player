# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so

# Distribution / packaging
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
*.manifest
*.spec

# Local user configurations & temporary files
settings.json
*.tmp
_temp*
*~

# Scratch & unneeded raw extraction assets
assets_eyes/
assets/sounds/legacy/
build_stage/
# Music tracking rule: Only track Cyberpunk Edgerunners and empty Downloaded Songs folder
music/*
!music/Cyberpunk Edgerunners/
!music/Downloaded Songs/
music/Downloaded Songs/*
!music/Downloaded Songs/.gitkeep

# OS generated files
Thumbs.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store

# IDE and Editor files
.vscode/
.idea/
*.swp
*.swo
