@echo off
title Refreshing Windows Icon Cache...
echo Closing Windows Explorer...
taskkill /f /im explorer.exe >nul 2>&1
timeout /t 1 /nobreak >nul
echo Purging stale icon caches...
del /f /q "%localappdata%\IconCache.db" >nul 2>&1
del /f /q "%localappdata%\Microsoft\Windows\Explorer\iconcache*" >nul 2>&1
del /f /q "%localappdata%\Microsoft\Windows\Explorer\thumbcache*" >nul 2>&1
echo Restarting Windows Explorer...
start explorer.exe
echo Done! Icon cache refreshed.
